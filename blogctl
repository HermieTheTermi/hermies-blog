def esc(text):
    return html.escape(str(text), quote=True)


def escape_tooltip(text):
    text = " ".join(str(text or "").split())
    return html.escape(text, quote=True)


_LEXIKON_CACHE = {}


def load_lexikon(path=None):
    target = path or LEXIKON_JSON
    if not os.path.isfile(target):
        return {}
    try:
        mtime = os.path.getmtime(target)
        cached = _LEXIKON_CACHE.get(target)
        if cached and cached[0] == mtime:
            return cached[1]
        with open(target, "r", encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, dict):
            _LEXIKON_CACHE[target] = (mtime, data)
            return data
    except Exception:
        pass
    return {}


def _render_lexikon_markers(text, lexikon=None, tracker=None, prefix=""):
    if lexikon is None:
        lexikon = load_lexikon()
    if not lexikon:
        return text
    if tracker is None:
        tracker = {}

    ci_map = {k.lower(): (k, v) for k, v in lexikon.items()}

    def _replace(match):
        raw = match.group(1)
        term = raw.strip()
        if term.startswith("chart:"):
            return match.group(0)
        unescaped_term = html.unescape(term)
        explanation = None
        anchor_term = term

        if term in lexikon:
            explanation = lexikon[term]
        elif unescaped_term in lexikon:
            explanation = lexikon[unescaped_term]
            anchor_term = unescaped_term
        elif term.lower() in ci_map:
            canonical, explanation = ci_map[term.lower()]
            anchor_term = canonical
        elif unescaped_term.lower() in ci_map:
            canonical, explanation = ci_map[unescaped_term.lower()]
            anchor_term = canonical

        if explanation is None:
            return match.group(0)

        anchor = slugify(anchor_term)
        tracker[anchor] = tracker.get(anchor, 0) + 1
        count = tracker[anchor]
        pop_id = "lex-%s" % anchor if count == 1 else "lex-%s-%d" % (anchor, count)
        tip = escape_tooltip(explanation)

        button = '<button type="button" class="lex" popovertarget="%s" data-tip="%s">%s</button>' % (
            pop_id, tip, term
        )
        span = '<span class="lex-pop" popover id="%s"><strong>%s</strong> %s <a href="%slexikon.html#%s">Im Lexikon</a></span>' % (
            pop_id, esc(anchor_term), tip, prefix, anchor
        )
        return button + span

    return LEX_MARKER_RE.sub(_replace, text)


