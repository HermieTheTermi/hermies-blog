def load_sources():
    if not os.path.isfile(SOURCE_JSON):
        return {"settings": {}, "sources": []}
    try:
        with open(SOURCE_JSON, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except Exception as exc:
        raise ValueError("content/sources.json ist unlesbar: %s" % exc)
    if not isinstance(data, dict):
        return {"settings": {}, "sources": []}
    settings = data.get("settings")
    sources = data.get("sources")
    if not isinstance(settings, dict):
        settings = {}
    if not isinstance(sources, list):
        sources = []
    return {"settings": settings, "sources": sources}


def _localname(tag):
    if isinstance(tag, str) and "}" in tag:
        return tag.rsplit("}", 1)[1]
    return tag


def _child_text(elem, names):
    for child in elem:
        if _localname(child.tag) in names:
            if child.text and child.text.strip():
                return child.text.strip()
    return ""


def parse_feed(data):
    root = xml.etree.ElementTree.fromstring(data)
    entries = []
    for elem in root.iter():
        name = _localname(elem.tag)
        if name == "item":
            entries.append(_parse_rss_item(elem))
        elif name == "entry":
            entries.append(_parse_atom_entry(elem))
    return entries


def _parse_rss_item(item):
    title = _child_text(item, ("title",))
    link = _child_text(item, ("link",))
    if not link:
        link = _child_text(item, ("guid",))
    summary = _child_text(item, ("description", "summary", "encoded", "content"))
    date = _child_text(item, ("pubDate", "published", "updated", "date"))
    return {"title": title, "link": link, "summary": summary, "date": date}


def _parse_atom_entry(entry):
    title = _child_text(entry, ("title",))
    link = ""
    fallback = ""
    for child in entry:
        if _localname(child.tag) == "link":
            href = child.get("href") or ""
            rel = child.get("rel") or "alternate"
            if not fallback:
                fallback = href
            if rel == "alternate":
                link = href
                break
    if not link:
        link = fallback
    summary = _child_text(entry, ("summary", "content"))
    date = _child_text(entry, ("published", "updated", "pubDate"))
    return {"title": title, "link": link, "summary": summary, "date": date}


def parse_entry_datetime(value):
    value = str(value or "").strip()
    if not value:
        return ("", "")
    tz = get_berlin_tz()
    if ":" not in value:
        m = re.match(r"^(\d{4})-(\d{2})-(\d{2})$", value)
        if m:
            return (value, "")
        try:
            parsed = email.utils.parsedate(value)
            if parsed:
                return ("%04d-%02d-%02d" % (parsed[0], parsed[1], parsed[2]), "")
        except Exception:
            pass
        return ("", "")
    try:
        iso_val = value
        if iso_val.endswith(("Z", "z")):
            iso_val = iso_val[:-1] + "+00:00"
        dt = datetime.datetime.fromisoformat(iso_val)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=tz)
        else:
            dt = dt.astimezone(tz)
        return (dt.date().isoformat(), dt.strftime("%H:%M"))
    except Exception:
        pass
    try:
        dt = email.utils.parsedate_to_datetime(value)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=tz)
        else:
            dt = dt.astimezone(tz)
        return (dt.date().isoformat(), dt.strftime("%H:%M"))
    except Exception:
        pass
    m = re.match(r"(\d{4})-(\d{2})-(\d{2})", value)
    if m:
        return (m.group(0), "")
    return ("", "")


def parse_entry_date(value):
    d, _ = parse_entry_datetime(value)
    return d


def strip_html(value):
    text = re.sub(r"<[^>]+>", " ", str(value or ""))
    text = html.unescape(text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def excerpt_from_summary(value):
    text = strip_html(value)
    if len(text) > EXCERPT_LIMIT:
        text = text[: EXCERPT_LIMIT - 3].rstrip() + "..."
    return text


class _LinkParser(HTMLParser):
    def __init__(self):
        HTMLParser.__init__(self)
        self.links = []
        self._href = None
        self._text = []

    def handle_starttag(self, tag, attrs):
        if tag.lower() == "a":
            self._href = dict(attrs).get("href")
            self._text = []

    def handle_data(self, data):
        if self._href is not None:
            self._text.append(data)

    def handle_endtag(self, tag):
        if tag.lower() == "a" and self._href is not None:
            text = " ".join("".join(self._text).split())
            if text and self._href:
                self.links.append((text, self._href))
            self._href = None


HTML_LINK_TEXT_BLOCKLIST = {
    "contact", "products", "about", "about us", "careers", "jobs",
    "we are hiring", "pricing", "plans", "blog", "news", "home",
    "login", "log in", "sign up", "signup", "register", "privacy",
    "privacy policy", "terms", "terms of service", "imprint", "impressum",
    "cookies", "cookie settings", "newsletter", "subscribe", "demo",
    "book a demo", "docs", "documentation", "company", "research",
    "solutions", "customers", "partners", "security", "trust", "events",
    "github", "x", "twitter", "linkedin", "youtube", "discord",
    "read more", "learn more", "see all", "all posts",
}
HTML_LINK_MIN_TEXT = 15


def _is_article_link(source_path, link_path):
    source = (source_path or "/").rstrip("/")
    link_path = link_path or "/"
    if source == "":
        return bool([seg for seg in link_path.split("/") if seg])
    if not link_path.startswith(source + "/"):
        return False
    return bool(link_path[len(source):].strip("/"))


def parse_html_links(data, charset, base_url):
    if isinstance(data, bytes):
        document = data.decode(charset or "utf-8", errors="replace")
    else:
        document = data
    parser = _LinkParser()
    parser.feed(document)
    source_path = urllib.parse.urlparse(base_url).path or "/"
    entries = []
    seen = set()
    for raw_text, href in parser.links:
        href = str(href or "").strip()
        if not href or href.startswith("#"):
            continue
        if href.lower().startswith(("javascript:", "mailto:", "tel:")):
            continue
        link = urllib.parse.urljoin(base_url, href)
        parsed = urllib.parse.urlparse(link)
        if parsed.scheme not in ("http", "https"):
            continue
        if not _is_article_link(source_path, parsed.path or "/"):
            continue
        label = " ".join(str(raw_text).split())
        if len(label) < HTML_LINK_MIN_TEXT:
            continue
        if label.casefold() in HTML_LINK_TEXT_BLOCKLIST:
            continue
        link = urllib.parse.urlunparse(parsed._replace(fragment=""))
        if link in seen:
            continue
        seen.add(link)
        entries.append({"title": label, "link": link, "summary": "", "date": ""})
    return entries


def _decompress_body(data, content_encoding):
    encoding = (content_encoding or "").lower()
    want_gzip = ("gzip" in encoding) or ("x-gzip" in encoding)
    want_deflate = "deflate" in encoding
    for _ in range(4):
        if data[:2] == b"\x1f\x8b":
            try:
                data = gzip.decompress(data)
            except Exception:
                raise ValueError("gzip/deflate konnte nicht entpackt werden")
            want_gzip = False
            want_deflate = False
            continue
        if want_gzip:
            try:
                data = gzip.decompress(data)
            except Exception:
                raise ValueError("gzip/deflate konnte nicht entpackt werden")
            want_gzip = False
            continue
        if want_deflate:
            try:
                data = zlib.decompress(data)
            except Exception:
                try:
                    data = zlib.decompress(data, -zlib.MAX_WBITS)
                except Exception:
                    raise ValueError("gzip/deflate konnte nicht entpackt werden")
            want_deflate = False
            continue
        break
    return data


def http_get(url, user_agent):
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https"):
        raise ValueError("Nur http/https erlaubt: %s" % url)
    host = parsed.netloc
    now = time.monotonic()
    last = _last_fetch.get(host)
    if last is not None and now - last < MIN_HOST_INTERVAL:
        time.sleep(MIN_HOST_INTERVAL - (now - last))
    request = urllib.request.Request(url, headers={"User-Agent": user_agent})
    with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
        data = response.read()
        charset = response.headers.get_content_charset() or "utf-8"
        content_encoding = response.headers.get("Content-Encoding") or ""
    _last_fetch[host] = time.monotonic()
    data = _decompress_body(data, content_encoding)
    text = data.decode("utf-8", errors="replace")
    return text, charset


