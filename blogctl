            '<text x="%d" y="32" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="15" font-weight="700" fill="#111111">%s</text>'
            % (left, esc(disp_titel))
        ]
    if einheit:
        header_elements.append(
            '<text x="%d" y="%d" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="12" fill="#666666">in %s</text>'
            % (left, unit_y, esc(einheit))
        )

    grid_elements = []
    if typ in ("balken", "linie", "gestapelt", "flaeche", "punkte"):
        for t in ticks:
            y_pos = bottom - (t / y_max) * plot_height
            grid_elements.append(
                '<line x1="%d" y1="%.1f" x2="%d" y2="%.1f" stroke="#eeeeee" stroke-width="1" />'
