def rfc822_date(date_str, time_str=""):
    tz = get_berlin_tz()
    date_match = re.match(r"^(\d{4})-(\d{2})-(\d{2})$", str(date_str or "").strip())
    if date_match:
        year, month, day = int(date_match.group(1)), int(date_match.group(2)), int(date_match.group(3))
    else:
        year, month, day = 1970, 1, 1

    time_match = re.match(r"^([01]\d|2[0-3]):([0-5]\d)$", str(time_str or "").strip())
    if time_match:
        hour, minute, second = int(time_match.group(1)), int(time_match.group(2)), 0
    else:
        hour, minute, second = 0, 0, 0

    try:
        dt = datetime.datetime(year, month, day, hour, minute, second, tzinfo=tz)
    except Exception:
        dt = datetime.datetime(1970, 1, 1, 0, 0, 0, tzinfo=tz)

    weekday = WEEKDAY_NAMES[dt.weekday()]
    month_name = MONTH_NAMES[dt.month - 1]
    tz_offset = dt.strftime("%z")
    return "%s, %02d %s %04d %02d:%02d:%02d %s" % (
        weekday, dt.day, month_name, dt.year, dt.hour, dt.minute, dt.second, tz_offset)


def render_feed(site, posts):
    base = site["base_url"].rstrip("/")
    lines = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">',
        '  <channel>',
        '    <title>%s</title>' % esc(site["title"]),
        '    <link>%s/</link>' % esc(base),
        '    <description>%s</description>' % esc(site["description"]),
        '    <language>%s</language>' % esc(site["lang"]),
        '    <atom:link href="%s/feed.xml" rel="self" type="application/rss+xml"/>' % esc(base),
    ]
    for post in posts:
        link = "%s/%s.html" % (base, post["id"])
        lines.append('    <item>')
        lines.append('      <title>%s</title>' % esc(post["title"]))
        lines.append('      <link>%s</link>' % esc(link))
        lines.append('      <guid isPermaLink="true">%s</guid>' % esc(link))
        lines.append('      <pubDate>%s</pubDate>' % rfc822_date(post["date"], post.get("time", "")))
        lines.append('      <description>%s</description>' % esc(post["summary"]))
        lines.append('    </item>')
    lines.append('  </channel>')
    lines.append('</rss>')
    return "\n".join(lines) + "\n"


def render_sitemap(site, urls):
    base = site["base_url"].rstrip("/")
    lines = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">',
    ]
    for loc, lastmod in urls:
        lines.append('  <url>')
        lines.append('    <loc>%s</loc>' % esc(base + "/" + loc))
        if lastmod:
            lines.append('    <lastmod>%s</lastmod>' % esc(lastmod))
        lines.append('  </url>')
    lines.append('</urlset>')
    return "\n".join(lines) + "\n"


# --- Build ------------------------------------------------------------------

def _collect_posts():
    posts = []
    for item in list_articles("published"):
        fm, body = read_article(item["path"])
        tags = fm.get("tags") or []
        posts.append({
            "id": item["id"],
            "title": fm.get("title") or item["id"],
            "date": str(fm.get("date") or ""),
            "time": str(fm.get("time") or ""),
            "summary": str(fm.get("summary") or ""),
            "tags": tags,
            "source_url": str(fm.get("source_url") or ""),
            "source_name": str(fm.get("source_name") or ""),
            "body": body,
        })
    posts.sort(key=lambda p: (str(p["date"] or ""), str(p.get("time") or "00:00"), p["id"]), reverse=True)
    return posts


def do_build(out_arg):
    site = load_site()
    tpl = load_templates()
    out_dir = os.path.abspath(out_arg or "dist")
    posts = _collect_posts()

    tag_map = {}
    for post in posts:
        for tag in _as_list(post["tags"]):
            key = _tag_slug(tag)
            if key not in tag_map:
                tag_map[key] = tag
    tag_items = sorted(tag_map.items(), key=lambda kv: (kv[1].lower(), kv[0]))

    if os.path.isdir(out_dir):
        shutil.rmtree(out_dir)
    os.makedirs(out_dir)
    os.makedirs(os.path.join(out_dir, "tag"))

    def write(rel, content):
        path = os.path.join(out_dir, rel)
        parent = os.path.dirname(path)
        if parent and not os.path.isdir(parent):
            os.makedirs(parent)
        with open(path, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(content)

    write("style.css", tpl["style.css"])

    latest = posts[0]["date"] if posts else ""
    pages = 0

    index_body = fill(tpl["index.html"], {"POST_LIST": _post_list_html(posts, "")})
    write("index.html", render_base(
        tpl, site, "", site["title"], site["description"], index_body))
    pages += 1

    page_list = list_pages()
    for page in page_list:
        content = fill(tpl["page.html"], {
            "PAGE_TITLE": esc(page["title"]),
            "PAGE_BODY": render_markdown(page["body"]),
        })
        title = "%s – %s" % (page["title"], site["title"])
        write(page["slug"] + ".html", render_base(
            tpl, site, "", title, site["description"], content))
        pages += 1

    for post in posts:
        tags = _as_list(post["tags"])
        tag_html = ""
        if tags:
            tag_html = ' · <span class="tags">%s</span>' % _tag_links_html(tags, "")
        source_html = ""
        if post["source_url"]:
            source_label = post["source_name"] or "Quelle"
            source_html = ' · <a class="source" href="%s">%s</a>' % (
                esc(post["source_url"]), esc(source_label))
        dt_attr = format_datetime_attr(post["date"], post.get("time", ""))
        display_date = format_display_date(post["date"], post.get("time", ""))
        content = fill(tpl["post.html"], {
            "HOME_HREF": "index.html",
            "POST_TITLE": esc(post["title"]),
            "POST_DATE": esc(display_date),
            "POST_DATETIME": esc(dt_attr),
            "POST_TAGS": tag_html,
            "POST_SOURCE": source_html,
            "POST_BODY": render_markdown(post["body"]),
        })
        title = "%s – %s" % (post["title"], site["title"])
        write(post["id"] + ".html", render_base(
            tpl, site, "", title, post["summary"] or site["description"], content))
        pages += 1

    overview = []
    if tag_items:
        overview.append('<ul class="tag-list">')
        for key, name in tag_items:
            count = sum(
                1 for p in posts
                if key in [_tag_slug(t) for t in _as_list(p["tags"])])
            overview.append(
                '  <li><a class="tag" href="tag/%s.html">#%s</a> '
                '<span class="count">(%d)</span></li>' % (key, esc(name), count))
        overview.append('</ul>')
    else:
        overview.append('<p class="empty">Noch keine Tags.</p>')
    write("tags.html", render_base(
        tpl, site, "", "Tags – " + site["title"], "Alle Tags",
        fill(tpl["tag.html"], {
            "TAG_NAME": "Tags",
            "POST_LIST": "\n".join(overview) + "\n",
        })))
    pages += 1

    for key, name in tag_items:
        tagged = [
            p for p in posts
            if key in [_tag_slug(t) for t in _as_list(p["tags"])]]
        content = fill(tpl["tag.html"], {
            "TAG_NAME": "#" + esc(name),
            "POST_LIST": _post_list_html(tagged, "../"),
        })
        write("tag/%s.html" % key, render_base(
            tpl, site, "../", "%s – %s" % (name, site["title"]),
            "Beiträge mit Tag %s" % name, content))
        pages += 1

    lexikon = load_lexikon()
    lex_entries = []
    sorted_terms = sorted(lexikon.items(), key=lambda kv: kv[0].lower())
    for term, text in sorted_terms:
        slug = slugify(term)
        lex_entries.append(
            '  <div class="lex-entry" id="%s">\n    <h2>%s</h2>\n    <p>%s</p>\n  </div>' % (
                slug, esc(term), esc(text)
            )
        )
    if lex_entries:
        lex_list_html = '<div class="lex-list">\n%s\n</div>\n' % "\n".join(lex_entries)
    else:
        lex_list_html = '<p class="empty">Noch keine Einträge im Lexikon.</p>\n'

    lexikon_content = fill(tpl["lexikon.html"], {"LEXIKON_LIST": lex_list_html})
    write("lexikon.html", render_base(
        tpl, site, "", "Lexikon – " + site["title"], "Begriffe und Erklärungen",
        lexikon_content))
    pages += 1

    write("feed.xml", render_feed(site, posts))

    urls = [("index.html", latest)]
    for page in page_list:
        urls.append((page["slug"] + ".html", ""))
    for post in posts:
        urls.append((post["id"] + ".html", post["date"]))
    urls.append(("tags.html", latest))
    for key, _name in tag_items:
        urls.append(("tag/%s.html" % key, latest))
    urls.append(("lexikon.html", latest))
    write("sitemap.xml", render_sitemap(site, urls))

    return out_dir, pages


def cmd_build(args):
    out_arg = getattr(args, "out", None) or "dist"
    _out_dir, pages = do_build(out_arg)
    if getattr(args, "json", False):
        emit_json({"ok": True, "out": out_arg, "pages": pages})
    else:
        sys.stdout.write("Site gebaut: %s (%d Seiten)\n" % (out_arg, pages))
    return 0


def _make_handler(directory):
    class _Handler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=directory, **kwargs)

        def log_message(self, fmt, *args):
            sys.stdout.write("[serve] %s %s\n" % (self.address_string(), fmt % args))
            sys.stdout.flush()

    return _Handler


class _Server(http.server.ThreadingHTTPServer):
    allow_reuse_address = True

    def server_bind(self):
        # HTTPServer.server_bind() calls socket.getfqdn(), which can hang for a
        # long time on macOS due to an mDNS reverse lookup. Bind directly.
        socketserver.TCPServer.server_bind(self)
        host, port = self.server_address[:2]
        self.server_name = str(host)
        self.server_port = int(port)


def cmd_serve(args):
    out_arg = getattr(args, "out", None) or "dist"
    out_dir, pages = do_build(out_arg)
    port = getattr(args, "port", None) or 8080
    httpd = _Server(("127.0.0.1", port), _make_handler(out_dir))
    sys.stdout.write("Vorschau unter http://127.0.0.1:%d/ (%s, %d Seiten)\n" % (
        port, out_arg, pages))
    sys.stdout.flush()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()
    sys.stdout.write("\nServer gestoppt.\n")
    return 0


