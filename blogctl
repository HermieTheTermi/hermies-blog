    return slug


def _older_than(date_str, days):
    try:
        entry_date = datetime.datetime.strptime(date_str, "%Y-%m-%d").date()
    except Exception:
        return False
    try:
        cutoff = datetime.datetime.strptime(today_iso(), "%Y-%m-%d").date() - datetime.timedelta(days=days)
    except Exception:
        cutoff = datetime.date.today() - datetime.timedelta(days=days)
    return entry_date < cutoff


def cmd_scrape(args):
    ensure_dirs()
    config = load_sources()
    settings = config["settings"]
    sources = config["sources"]
    user_agent = str(settings.get("user_agent") or DEFAULT_USER_AGENT)
    try:
        max_items = int(settings.get("max_items_per_run", DEFAULT_MAX_ITEMS))
    except Exception:
        max_items = DEFAULT_MAX_ITEMS
    if args.limit is not None:
        max_items = args.limit
    per_source = args.per_source if args.per_source is not None else 2
    if per_source < 0:
        per_source = 0

    selected = []
    if args.source:
        for source in sources:
            if str(source.get("name")) == args.source:
                selected.append(source)
        if not selected:
            message = "Quelle nicht gefunden: %s" % args.source
            sys.stderr.write("Fehler: %s\n" % message)
            if args.json:
                emit_json({"ok": False, "created": [], "skipped": 0,
                           "errors": [{"source": args.source, "message": message}]})
            return 1
    else:
        for source in sources:
            if source.get("enabled"):
                selected.append(source)

    existing = existing_source_urls()
    created = []
    skipped = 0
    errors = []
    attempted = 0
    successes = 0
    remaining = max_items
    reserved = set()

    for source in selected:
        if remaining <= 0:
            break
        name = str(source.get("name") or source.get("url") or "(unbenannt)")
        source_type = str(source.get("type") or "rss").lower()
        url = str(source.get("url") or "")
        attempted += 1
        try:
            if not url:
                raise ValueError("url fehlt")
            data, charset = http_get(url, user_agent)
            if source_type == "rss":
                entries = parse_feed(data)
            elif source_type == "html":
                entries = parse_html_links(data, charset, url)
            else:
                raise ValueError("unbekannter type: %s" % source_type)
            successes += 1
        except Exception as exc:
            errors.append({"source": name, "message": str(exc)})
            sys.stderr.write("Fehler (Quelle %s): %s\n" % (name, exc))
            continue

        entries = list(entries)[:min(per_source, remaining)]
        tags = source.get("tags") or []
        for entry in entries:
            if remaining <= 0:
                break
            link = str(entry.get("link") or "").strip()
            if not link:
                continue
            if link in existing or link in reserved:
                skipped += 1
                continue
            entry_date, entry_time = parse_entry_datetime(entry.get("date"))
            if args.since_days is not None and entry_date and _older_than(entry_date, args.since_days):
                skipped += 1
                continue
            date = entry_date or today_iso()
            time_val = entry_time
            if args.dry_run:
                title = strip_html(entry.get("title")) or "Ohne Titel"
                draft_id = _unique_slug_with(slugify(title), reserved)
                reserved.add(draft_id)
                created.append(draft_id)
                if not args.json:
                    sys.stdout.write("[dry-run] wuerde anlegen: %s (%s)\n" % (draft_id, link))
            else:
                draft_id = write_scraped_draft(entry, source, date, time_val, tags, reserved)
                reserved.add(draft_id)
                created.append(draft_id)
                if source.get("auto_publish"):
                    _move([draft_id], POSTS, "published")
                if not args.json:
                    sys.stdout.write("Entwurf angelegt: %s\n" % draft_id)
            existing.add(link)
            remaining -= 1

    ok = not (attempted > 0 and successes == 0)
    if args.json:
        emit_json({"ok": ok, "created": created, "skipped": skipped, "errors": errors})
    else:
        if not created and not errors:
            sys.stdout.write("Keine neuen Eintraege.\n")
        sys.stdout.write("scrape: %d neu, %d uebersprungen, %d Fehler\n" % (
            len(created), skipped, len(errors)))
    return 0 if ok else 1


def _run_git(args, cwd=None, check=True):
    command = ["git"] + [str(a) for a in args]
    result = subprocess.run(command, cwd=cwd or ROOT,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            universal_newlines=True)
    if check and result.returncode != 0:
        message = (result.stderr or result.stdout or "").strip()
        if not message:
            message = "git %s fehlgeschlagen" % " ".join(str(a) for a in args)
        raise RuntimeError(message)
    return result


def _check_result():
    import io
    buffer = io.StringIO()
    old_stdout = sys.stdout
    sys.stdout = buffer
    try:
        code = cmd_check(argparse.Namespace(json=False))
    finally:
        sys.stdout = old_stdout
    return code, buffer.getvalue()


def release_notes(post, site):
    base_url = (site.get("base_url") or "").rstrip("/")
    post_id = post.get("id") or post.get("slug") or ""
    display_date = format_display_date(post.get("date"), post.get("time", ""))
    summary = post.get("summary") or ""
    return "%s\n\nArtikel: %s/%s.html\n\nVeröffentlicht: %s" % (
        summary, base_url, post_id, display_date
    )


def pending_releases(posts, state):
    if state and isinstance(state, dict):
        if "released" in state and isinstance(state["released"], dict):
            released_map = state["released"]
        else:
            released_map = state
    else:
        released_map = {}
    pending = []
    for post in posts:
        slug = post.get("id") or post.get("slug")
        if slug and slug not in released_map:
            pending.append(post)
    pending.sort(key=lambda p: (
        str(p.get("date") or ""),
        str(p.get("time") or "00:00"),
        str(p.get("id") or p.get("slug") or "")
    ))
    return pending


def run_gh(argv):
    command = ["gh"] + [str(a) for a in argv]
    return subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        universal_newlines=True,
    )


def load_releases_state(path=None):
    target = path or RELEASES_JSON
    if not os.path.isfile(target):
        return None
    try:
        with open(target, "r", encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, dict) and "released" in data and isinstance(data["released"], dict):
            return data
        return {"released": {}}
    except Exception:
        return {"released": {}}


def save_releases_state(path, state):
    target = path or RELEASES_JSON
    released = state.get("released", {}) if isinstance(state, dict) else {}
    sorted_released = dict(sorted(released.items(), key=lambda kv: kv[0]))
    payload = {"released": sorted_released}
    content = json.dumps(payload, indent=2, ensure_ascii=False) + "\n"
    parent = os.path.dirname(target)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(target, "w", encoding="utf-8", newline="\n") as handle:
        handle.write(content)


def sync_releases(posts=None, site=None, branch="main", no_releases=False, state_path=None, json_mode=False):
    target_path = state_path or RELEASES_JSON
    if posts is None:
        posts = _collect_posts()
    if site is None:
        site = load_site()

    if no_releases:
        return {"created": [], "skipped": len(posts), "baseline": False, "error": None}

    state = load_releases_state(target_path)

    # Erstlauf: Datei existiert nicht -> Basisstand anlegen: alle aktuell veröffentlichten Slugs eintragen, kein Release erzeugen
    if state is None:
        released = {}
        for p in posts:
            slug = p.get("id") or p.get("slug")
            if slug:
                released[slug] = slug
        new_state = {"released": released}
        save_releases_state(target_path, new_state)
        count = len(released)
        if not json_mode:
            sys.stdout.write("Release-Basisstand gesetzt: %d Artikel, keine Benachrichtigungen erzeugt\n" % count)
        return {"created": [], "skipped": count, "baseline": True, "error": None}

    # Folge-Läufe
    pending = pending_releases(posts, state)
    already_released_count = len(posts) - len(pending)
    if not pending:
        return {"created": [], "skipped": len(posts), "baseline": False, "error": None}

    # gh Verfügbarkeit und Authentifizierung prüfen
    try:
        auth_proc = run_gh(["auth", "status"])
        if auth_proc.returncode != 0:
            err_msg = (auth_proc.stderr or auth_proc.stdout or "gh auth status fehlgeschlagen").strip()
            sys.stderr.write("Warnung: gh nicht angemeldet oder Fehler bei Authentifizierung: %s\n" % err_msg)
            return {
                "created": [],
                "skipped": already_released_count,
                "baseline": False,
                "error": "gh nicht angemeldet: %s" % err_msg,
            }
    except FileNotFoundError:
        sys.stderr.write("Warnung: gh CLI ist nicht installiert\n")
        return {
            "created": [],
            "skipped": already_released_count,
            "baseline": False,
            "error": "gh nicht installiert",
        }
    except Exception as exc:
        sys.stderr.write("Warnung: Fehler beim Aufruf von gh: %s\n" % exc)
        return {
            "created": [],
            "skipped": already_released_count,
            "baseline": False,
            "error": str(exc),
        }

    created = []
    error_msg = None
    for post in pending:
        tag = post.get("id") or post.get("slug")
        title = post.get("title") or tag
        notes = release_notes(post, site)
        argv = ["release", "create", tag, "--title", title, "--notes", notes, "--target", branch]
        try:
            proc = run_gh(argv)
            if proc.returncode != 0:
                err = (proc.stderr or proc.stdout or "gh release create fehlgeschlagen").strip()
                sys.stderr.write("Warnung: gh release create für '%s' fehlgeschlagen: %s\n" % (tag, err))
                error_msg = err
                break
            created.append(tag)
            state["released"][tag] = tag
            save_releases_state(target_path, state)
            if not json_mode:
                sys.stdout.write("Release erstellt: %s\n" % tag)
        except Exception as exc:
            sys.stderr.write("Warnung: gh release create für '%s' fehlgeschlagen: %s\n" % (tag, exc))
            error_msg = str(exc)
            break

    total_skipped = len(posts) - len(created)
    return {
        "created": created,
        "skipped": total_skipped,
        "baseline": False,
        "error": error_msg,
    }


def cmd_deploy(args):
    code, check_output = _check_result()
    if code != 0:
        if check_output:
            sys.stderr.write(check_output)
            if not check_output.endswith("\n"):
                sys.stderr.write("\n")
        sys.stderr.write("Fehler: check fehlgeschlagen, deploy abgebrochen\n")
        if args.json:
            emit_json({"ok": False, "error": "check fehlgeschlagen"})
        return 1

    remotes = _run_git(["remote"]).stdout.split()
    if "origin" not in remotes:
        message = "Remote 'origin' existiert nicht"
        sys.stderr.write("Fehler: %s\n" % message)
        if args.json:
            emit_json({"ok": False, "error": message})
        return 1
    origin_url = _run_git(["remote", "get-url", "origin"]).stdout.strip()

    dist_dir = os.path.join(ROOT, "dist")
    do_build(dist_dir)

    _run_git(["add", "-A"])
    status = _run_git(["status", "--porcelain"]).stdout.strip()
    commit = ""
    if status:
        _run_git(["commit", "-m", "Deploy: Blog veroeffentlichen"])
        commit = _run_git(["rev-parse", "--short", "HEAD"]).stdout.strip()

    branch = _run_git(["rev-parse", "--abbrev-ref", "HEAD"]).stdout.strip() or "main"

    rebased = False
    _run_git(["fetch", "origin"])
    ancestor = _run_git(
        ["merge-base", "--is-ancestor", "origin/%s" % branch, branch], check=False)
    if ancestor.returncode != 0:
        pull = _run_git(["pull", "--rebase", "origin", branch], check=False)
        if pull.returncode != 0:
            _run_git(["rebase", "--abort"], check=False)
            message = (pull.stderr or pull.stdout or "").strip()
            if not message:
                message = "git pull --rebase origin %s fehlgeschlagen" % branch
            sys.stderr.write("Fehler: Rebase fehlgeschlagen, deploy abgebrochen\n")
            sys.stderr.write(message + "\n")
            if args.json:
                emit_json({"ok": False, "error": "Rebase fehlgeschlagen"})
            return 1
        rebased = True
        if not args.json:
            sys.stdout.write("Remote-Stand eingefügt (rebase)\n")
        code, check_output = _check_result()
        if code != 0:
            if check_output:
                sys.stderr.write(check_output)
                if not check_output.endswith("\n"):
                    sys.stderr.write("\n")
            sys.stderr.write(
                "Fehler: check nach Rebase fehlgeschlagen, deploy abgebrochen\n")
            if args.json:
                emit_json({"ok": False, "error": "check nach Rebase fehlgeschlagen"})
            return 1

    _run_git(["push", "origin", branch])

    site = load_site()
    posts = _collect_posts()
    rel_info = {"created": [], "skipped": len(posts), "baseline": False, "error": None}
    if not getattr(args, "no_releases", False):
        rel_info = sync_releases(
            posts=posts,
            site=site,
            branch=branch,
            no_releases=False,
            state_path=RELEASES_JSON,
            json_mode=args.json
        )
        rel_path = os.path.relpath(RELEASES_JSON, ROOT)
        status_after = _run_git(["status", "--porcelain", rel_path], check=False).stdout.strip()
        if status_after:
            _run_git(["add", rel_path])
            msg = "Release-Basisstand initialisieren" if rel_info.get("baseline") else "Release-Status aktualisieren"
            _run_git(["commit", "-m", msg])
            _run_git(["push", "origin", branch])
            commit = _run_git(["rev-parse", "--short", "HEAD"]).stdout.strip()

    temp_dir = tempfile.mkdtemp(prefix="blogctl-gh-pages-")
    try:
        for name in os.listdir(dist_dir):
            source = os.path.join(dist_dir, name)
            target = os.path.join(temp_dir, name)
            if os.path.isdir(source):
                shutil.copytree(source, target)
            else:
                shutil.copy2(source, target)
        with open(os.path.join(temp_dir, ".nojekyll"), "w", encoding="utf-8") as handle:
            handle.write("")
        _run_git(["init"], cwd=temp_dir)
        _run_git(["add", "-A"], cwd=temp_dir)
        _run_git(["-c", "user.name=blogctl", "-c", "user.email=blogctl@localhost",
                  "commit", "-m", "Deploy: gh-pages build"], cwd=temp_dir)
        _run_git(["remote", "add", "origin", origin_url], cwd=temp_dir)
        _run_git(["push", "--force", "origin", "HEAD:gh-pages"], cwd=temp_dir)
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

    url = site["base_url"]
    if args.json:
        emit_json({"ok": True, "commit": commit, "pushed_to": "gh-pages",
                   "url": url, "rebased": rebased, "releases": rel_info})
    else:
        sys.stdout.write("Deployed: %s -> %s\n" % (branch, url))
        if commit:
            sys.stdout.write("Commit: %s\n" % commit)
    return 0


def build_parser():
    parser = argparse.ArgumentParser(prog="blogctl", description="Blog-CLI")
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("new")
    p.add_argument("--title", required=True)
    p.add_argument("--slug")
    p.add_argument("--tags")
    p.add_argument("--summary")
    p.add_argument("--source-url", dest="source_url")
    p.add_argument("--source-name", dest="source_name")
    p.add_argument("--date")
    p.add_argument("--time")
    p.add_argument("--body-file", dest="body_file")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("list")
    group = p.add_mutually_exclusive_group()
    group.add_argument("--drafts", action="store_true")
    group.add_argument("--posts", action="store_true")
    p.add_argument("--limit", type=int)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("show")
    p.add_argument("id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("edit")
    p.add_argument("id")
    p.add_argument("--title")
    p.add_argument("--tags")
    p.add_argument("--summary")
    p.add_argument("--time")
    p.add_argument("--body-file", dest="body_file")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_edit)

    p = sub.add_parser("publish")
    p.add_argument("ids", nargs="+")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_publish)

    p = sub.add_parser("unpublish")
    p.add_argument("ids", nargs="+")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_unpublish)

    p = sub.add_parser("rm")
    p.add_argument("id")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_rm)

    p = sub.add_parser("check")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("lexikon")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_lexikon)

    p = sub.add_parser("charts")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_charts)

    p = sub.add_parser("build")
    p.add_argument("--out", default="dist")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("serve")
    p.add_argument("--out", default="dist")
    p.add_argument("--port", type=int, default=8080)
    p.set_defaults(func=cmd_serve)

    p = sub.add_parser("scrape")
    p.add_argument("--source")
    p.add_argument("--per-source", dest="per_source", type=int, default=2)
    p.add_argument("--limit", type=int)
    p.add_argument("--since-days", dest="since_days", type=int)
    p.add_argument("--dry-run", dest="dry_run", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_scrape)

    p = sub.add_parser("deploy")
    p.add_argument("--no-releases", dest="no_releases", action="store_true",
                   help="Erstellen von GitHub-Releases überspringen")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_deploy)

    return parser


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return 0 if exc.code in (0, None) else 1
    if not getattr(args, "cmd", None):
        parser.print_help(sys.stderr)
        return 1
    try:
        ensure_dirs()
        return args.func(args)
    except ValueError as exc:
        sys.stderr.write("Fehler: %s\n" % exc)
        if getattr(args, "json", False):
            emit_json({"ok": False, "error": str(exc)})
        return 1
    except Exception as exc:
        sys.stderr.write("Fehler: %s\n" % exc)
        if getattr(args, "json", False):
            emit_json({"ok": False, "error": str(exc)})
        return 1


if __name__ == "__main__":
    sys.exit(main())
