def rfc822_date(date_str):
    try:
        day = datetime.datetime.strptime(str(date_str), "%Y-%m-%d")
    except Exception:
        day = datetime.datetime(1970, 1, 1)
    return "%s, %02d %s %04d 00:00:00 +0000" % (
        WEEKDAY_NAMES[day.weekday()], day.day,
        MONTH_NAMES[day.month - 1], day.year)


def render_feed(site, posts):
    base = site["base_url"].rstrip("/")
    lines = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">',
        '  <channel>',
        '    <title>%s</title>' % esc(site["title"]),
        '    <link>%s/</link>' % esc(base),
        '    <description>%s</description>' % esc(site["description"]),
        '    <language>%s</language>' % esc(site["lang"]),
        '    <atom:link href="%s/feed.xml" rel="self" type="application/rss+xml"/>' % esc(base),
    ]
    for post in posts:
        link = "%s/%s.html" % (base, post["id"])
        lines.append('    <item>')
        lines.append('      <title>%s</title>' % esc(post["title"]))
        lines.append('      <link>%s</link>' % esc(link))
        lines.append('      <guid isPermaLink="true">%s</guid>' % esc(link))
        lines.append('      <pubDate>%s</pubDate>' % rfc822_date(post["date"]))
        lines.append('      <description>%s</description>' % esc(post["summary"]))
        lines.append('    </item>')
    lines.append('  </channel>')
    lines.append('</rss>')
    return "\n".join(lines) + "\n"


def render_sitemap(site, urls):
    base = site["base_url"].rstrip("/")
    lines = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">',
    ]
    for loc, lastmod in urls:
        lines.append('  <url>')
        lines.append('    <loc>%s</loc>' % esc(base + "/" + loc))
        if lastmod:
            lines.append('    <lastmod>%s</lastmod>' % esc(lastmod))
        lines.append('  </url>')
    lines.append('</urlset>')
    return "\n".join(lines) + "\n"


