def fill(template, mapping):
    out = template
    for key, value in mapping.items():
        out = out.replace("{{" + key + "}}", value)
    return out


def wrap_chart_title(titel, max_single=48, max_line=55, max_total=110):
    titel = (titel or "").strip()
    if not titel:
        return []
    if len(titel) <= max_single:
        return [titel]

    words = titel.split()
    if len(words) <= 1:
        if len(titel) > max_total:
            return [titel[:max_line], titel[max_line:max_total - 1] + "…"]
        elif len(titel) > max_line:
            return [titel[:max_line], titel[max_line:]]
        return [titel]

    best_split = None
    best_diff = float("inf")
    for i in range(1, len(words)):
        l1 = " ".join(words[:i])
        l2 = " ".join(words[i:])
        if len(l1) <= max_line and len(l2) <= max_line:
            diff = abs(len(l1) - len(l2))
            if diff < best_diff:
                best_diff = diff
                best_split = (l1, l2)

    if best_split:
        return [best_split[0], best_split[1]]

    l1_words = []
    curr_len = 0
    rem_idx = len(words)
    for i, w in enumerate(words):
        add_len = len(w) if not l1_words else len(w) + 1
        if curr_len + add_len <= max_line:
            l1_words.append(w)
            curr_len += add_len
        else:
            rem_idx = i
            break

    if not l1_words:
        l1_words = [words[0]]
        rem_idx = 1

    line1 = " ".join(l1_words)
    rem_words = words[rem_idx:]
    line2 = " ".join(rem_words)

    if len(line2) > max_line or (len(line1) + len(line2) > max_total):
        cutoff = max_line - 1
        l2_sub = line2[:cutoff]
        if " " in l2_sub:
            l2_sub = l2_sub.rsplit(" ", 1)[0]
        line2 = l2_sub.rstrip(" ,:;.-") + "…"

    return [line1, line2]


def generate_chart_svg(data, chart_name=""):
    titel = data.get("titel", "")
    einheit = data.get("einheit", "")
    typ = data.get("typ")
    hinweis = data.get("hinweis", "")

    title_lines = wrap_chart_title(titel)
    is_two_line = len(title_lines) > 1

    dy = 25 if is_two_line else 0
    width = 680
    if typ == "anteil":
        if "anteile" in data:
            total_leg_width = sum(12 + 6 + len(it.get("label", "")) * 7.5 + 16 for it in data["anteile"])
            height = (230 if total_leg_width > 544 else 200) + dy
        else:
            height = 180 + dy
    else:
        height = 390 + dy
    left = 68
    right = 650
    top = 75 + dy
    bottom = 320 + dy
    plot_width = right - left
    plot_height = bottom - top

    unit_y = 52 + (20 if is_two_line else 0)
    leg_y = 52 + (20 if is_two_line else 0)

    all_values = []
    if typ == "balken":
        if "werte" in data:
            for it in data["werte"]:
                all_values.append(it.get("wert", 0))
        elif "reihen" in data:
            for r in data["reihen"]:
                all_values.extend(r.get("werte", []))
    elif typ in ("linie", "flaeche", "punkte"):
        if "reihen" in data:
            for r in data["reihen"]:
                all_values.extend(r.get("werte", []))
    elif typ == "gestapelt":
        m = len(data.get("gruppen", []))
        reihen = data.get("reihen", [])
        for i in range(m):
            all_values.append(sum(r.get("werte", [])[i] for r in reihen if i < len(r.get("werte", []))))
    elif typ == "balken-horizontal":
        for it in data.get("werte", []):
            all_values.append(it.get("wert", 0))

    max_val = max(all_values + [0])
    ticks = calculate_ticks(max_val)
    y_max = ticks[-1] if ticks else 1
    if y_max <= 0:
        y_max = 1

    if is_two_line:
        title_ys = [26, 48]
        tspan_items = [
            '<tspan x="%d" y="%d">%s</tspan>' % (left, y, esc(line))
            for y, line in zip(title_ys, title_lines)
