                data_elements.append(
                    '<text x="%d" y="%d" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="14" fill="#555555">%s</text>'
                    % (lbl_x, pct_y - 2, esc(label))
                )
            if von != 100:
                detail_str = "%s von %s" % (format_german_number(wert), format_german_number(von))
                data_elements.append(
                    '<text x="%d" y="%d" text-anchor="end" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="13" fill="#888888">%s</text>'
                    % (bar_right, pct_y - 2, esc(detail_str))
                )

            data_elements.append(
                '<rect x="%d" y="%d" width="%d" height="%d" rx="6" fill="#eef2f6" />'
                % (bar_left, bar_y, bar_w, bar_h)
            )
            if fill_w > 0:
                data_elements.append(
                    '<rect x="%d" y="%d" width="%.1f" height="%d" rx="6" fill="#0075de" />'
                    % (bar_left, bar_y, fill_w, bar_h)
                )
            data_elements.append(
                '<text x="%d" y="%d" text-anchor="start" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="11" fill="#888888">0 %%</text>'
                % (bar_left, bar_y + bar_h + 16)
            )
            data_elements.append(
                '<text x="%d" y="%d" text-anchor="end" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="11" fill="#888888">100 %%</text>'
                % (bar_right, bar_y + bar_h + 16)
            )

        elif "anteile" in data:
            anteile = data["anteile"]
            total_val = sum(it.get("wert", 0) for it in anteile)
            is_normalized = abs(total_val - 100.0) > 0.001
            bar_y = 90 + dy
            bar_h = 36
            clip_id = "clip-bar-%s" % (slugify(chart_name) if chart_name else "anteil")

            data_elements.append(
                '<defs><clipPath id="%s"><rect x="%d" y="%d" width="%d" height="%d" rx="6" /></clipPath></defs>'
                % (clip_id, bar_left, bar_y, bar_w, bar_h)
            )
            data_elements.append('<g clip-path="url(#%s)">' % clip_id)

            cur_x = bar_left
            for idx, it in enumerate(anteile):
                val = it.get("wert", 0)
                color = CHART_PALETTE[idx % len(CHART_PALETTE)]
                frac = (val / total_val) if total_val > 0 else 0
                seg_w = frac * bar_w
                pct_val = frac * 100.0
                pct_str = "%s %%" % format_german_number(round(pct_val, 1))
                if is_normalized:
                    seg_text = "%s (%s)" % (pct_str, format_german_number(val))
                else:
                    seg_text = pct_str

                data_elements.append(
                    '<rect x="%.1f" y="%d" width="%.1f" height="%d" fill="%s" />'
                    % (cur_x, bar_y, seg_w, bar_h, color)
                )
                if seg_w >= 48:
                    data_elements.append(
                        '<text x="%.1f" y="%.1f" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="11" font-weight="600" fill="#ffffff">%s</text>'
                        % (cur_x + seg_w / 2, bar_y + bar_h / 2 + 4, esc(seg_text))
                    )
                elif seg_w >= 24:
                    data_elements.append(
                        '<text x="%.1f" y="%.1f" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="10" font-weight="600" fill="#ffffff">%s</text>'
                        % (cur_x + seg_w / 2, bar_y + bar_h / 2 + 3, esc(pct_str))
                    )
                cur_x += seg_w

            data_elements.append('</g>')

            leg_y = bar_y + bar_h + 30
            cur_leg_x = bar_left
            for idx, it in enumerate(anteile):
                lbl = it.get("label", "")
                color = CHART_PALETTE[idx % len(CHART_PALETTE)]
                w = 12 + 6 + len(lbl) * 7.5 + 16
                if cur_leg_x > bar_left and cur_leg_x + w > bar_right:
                    cur_leg_x = bar_left
                    leg_y += 22
                legend_elements.append(
                    '<rect x="%.1f" y="%.1f" width="12" height="12" rx="2" fill="%s" />'
                    % (cur_leg_x, leg_y - 10, color)
                )
                legend_elements.append(
                    '<text x="%.1f" y="%.1f" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="12" fill="#444444">%s</text>'
                    % (cur_leg_x + 16, leg_y, esc(lbl))
                )
                cur_leg_x += w


    svg_lines = [
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 %d %d" width="100%%" height="auto" role="img" class="chart-svg">' % (width, height),
        '  <title>%s</title>' % esc(titel),
        '  <rect width="100%" height="100%" fill="#ffffff" rx="8" />',
    ]
    for el in header_elements:
        svg_lines.append("  " + el)
    for el in legend_elements:
        svg_lines.append("  " + el)
    for el in grid_elements:
        svg_lines.append("  " + el)
    for el in data_elements:
        svg_lines.append("  " + el)
    svg_lines.append("</svg>")
    return "\n".join(svg_lines)


def render_chart_figure(chart_name, prefix=""):
    data, err = load_chart(chart_name)
    if data is None:
        raise ValueError("Fehler in Diagramm '%s': %s" % (chart_name, err))

    svg = generate_chart_svg(data, chart_name=chart_name)

    titel = data.get("titel", "")
    quelle = data.get("quelle", "")
    quelle_url = data.get("quelle_url", "")
    hinweis = data.get("hinweis", "")

    caption_parts = []
    if quelle:
        if quelle_url:
            caption_parts.append(
                '<span class="chart-source">Quelle: <a href="%s" target="_blank" rel="noopener">%s</a></span>'
                % (esc(quelle_url), esc(quelle))
            )
        else:
            caption_parts.append('<span class="chart-source">Quelle: %s</span>' % esc(quelle))
    if hinweis:
        caption_parts.append('<span class="chart-note">%s</span>' % esc(hinweis))

    if caption_parts:
        figcaption = '<figcaption class="chart-caption">\n  ' + "\n  ".join(caption_parts) + "\n</figcaption>"
        return '<figure class="chart-figure">\n' + svg + "\n" + figcaption + "\n</figure>"
    return '<figure class="chart-figure">\n' + svg + "\n</figure>"


def _render_chart_markers(text, prefix=""):
    def _replace(match):
        chart_name = match.group(1).strip()
        return render_chart_figure(chart_name, prefix=prefix)
    return CHART_INLINE_RE.sub(_replace, text)


# --- Markdown ---------------------------------------------------------------

def _render_inline_text(text, tracker=None, prefix=""):
    text = esc(text)
    text = IMG_RE.sub(
        lambda m: '<img src="%s" alt="%s">' % (m.group(2), m.group(1)), text)
    text = INLINE_LINK_RE.sub(
        lambda m: '<a href="%s">%s</a>' % (m.group(2), m.group(1)), text)
    text = BOLD_RE.sub(r"<strong>\1</strong>", text)
    text = ITALIC_RE.sub(r"<em>\1</em>", text)
    text = _render_lexikon_markers(text, tracker=tracker, prefix=prefix)
    text = _render_chart_markers(text, prefix=prefix)
    return text



def render_inline(text, tracker=None, prefix=""):
    text = str(text)
    parts = []
    pos = 0
    for match in CODE_SPAN_RE.finditer(text):
        if match.start() > pos:
            parts.append(("text", text[pos:match.start()]))
        parts.append(("code", match.group(1)))
        pos = match.end()
    if pos < len(text):
        parts.append(("text", text[pos:]))
    out = []
    for kind, value in parts:
        if kind == "code":
            out.append("<code>%s</code>" % esc(value))
        else:
            out.append(_render_inline_text(value, tracker=tracker, prefix=prefix))
    return "".join(out)


def _is_hr(line):
    return bool(re.match(r"^(-{3,}|\*{3,}|_{3,})$", line.strip()))


def _list_kind(line):
    stripped = line.strip()
    if re.match(r"^[-*+]\s+", stripped):
        return "ul"
    if re.match(r"^\d+[.)]\s+", stripped):
        return "ol"
    return None


def _is_block_start(line):
    stripped = line.strip()
    if stripped == "":
        return True
    if stripped.startswith("```"):
        return True
    if re.match(r"^#{1,6}\s+", stripped):
        return True
    if _is_hr(stripped):
        return True
    if stripped.startswith(">"):
        return True
    if _list_kind(stripped):
        return True
    if CHART_BLOCK_RE.match(stripped):
        return True
    return False


def render_markdown(text, prefix=""):
    if text is None:
        return ""
    tracker = {}
    text = str(text).replace("\r\n", "\n").replace("\r", "\n")
    lines = text.split("\n")
    out = []
    i = 0
    n = len(lines)
    while i < n:
        stripped = lines[i].strip()
        if stripped == "":
            i += 1
            continue
        if stripped.startswith("```"):
            lang = stripped[3:].strip()
            i += 1
            buf = []
            while i < n and not lines[i].strip().startswith("```"):
                buf.append(lines[i])
                i += 1
            if i < n:
                i += 1
            cls = ' class="language-%s"' % esc(slugify(lang)) if lang else ""
            out.append("<pre><code%s>%s</code></pre>" % (
                cls, esc("\n".join(buf))))
            continue
        chart_match = CHART_BLOCK_RE.match(stripped)
        if chart_match:
            out.append(render_chart_figure(chart_match.group(1), prefix=prefix))
            i += 1
            continue
        heading = re.match(r"^(#{1,6})\s+(.*?)\s*#*\s*$", stripped)
        if heading:
            level = min(len(heading.group(1)), 6)
            out.append("<h%d>%s</h%d>" % (
                level, render_inline(heading.group(2), tracker=tracker, prefix=prefix), level))
            i += 1
            continue
        if _is_hr(stripped):
            out.append("<hr>")
            i += 1
            continue
        if stripped.startswith(">"):
            buf = []
            while i < n and lines[i].strip().startswith(">"):
                buf.append(lines[i].strip()[1:].strip())
                i += 1
            out.append("<blockquote>%s</blockquote>" % render_inline(" ".join(buf), tracker=tracker, prefix=prefix))
            continue
        kind = _list_kind(stripped)
        if kind:
            tag = "ul" if kind == "ul" else "ol"
            items = []
            while i < n:
                cur = lines[i].strip()
                if _list_kind(cur) != kind:
                    break
                content = re.sub(r"^([-*+]|\d+[.)])\s+", "", cur)
                items.append("  <li>%s</li>" % render_inline(content, tracker=tracker, prefix=prefix))
                i += 1
            out.append("<%s>\n%s\n</%s>" % (tag, "\n".join(items), tag))
            continue
        buf = []
        while i < n and lines[i].strip() != "" and not _is_block_start(lines[i]):
            buf.append(lines[i].strip())
            i += 1
        if buf:
            out.append("<p>%s</p>" % render_inline(" ".join(buf), tracker=tracker, prefix=prefix))
        else:
            i += 1
    if not out:
        return ""
    return "\n".join(out) + "\n"


