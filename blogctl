CODE_SPAN_RE = re.compile(r"`([^`]+)`")
IMG_RE = re.compile(r"!\[([^\]]*)\]\(([^)\s]+)(?:\s+\"[^\"]*\")?\)")
INLINE_LINK_RE = re.compile(r"\[([^\]]+)\]\(([^)\s]+)(?:\s+\"[^\"]*\")?\)")
BOLD_RE = re.compile(r"\*\*(.+?)\*\*")
ITALIC_RE = re.compile(r"\*(.+?)\*")


def esc(text):
    return html.escape(str(text), quote=True)


def load_site():
    data = dict(DEFAULT_SITE)
    if os.path.isfile(SITE_JSON):
        try:
            with open(SITE_JSON, "r", encoding="utf-8") as handle:
                loaded = json.load(handle)
        except Exception as exc:
            raise ValueError("content/site.json ist unlesbar: %s" % exc)
        if isinstance(loaded, dict):
            for key in DEFAULT_SITE:
                if key in loaded and str(loaded[key]).strip():
                    data[key] = str(loaded[key]).strip()
    return data


def load_templates():
    tpl = {}
    for name in TEMPLATE_FILES:
        path = os.path.join(TEMPLATES, name)
        if not os.path.isfile(path):
            raise ValueError("Template fehlt: content/templates/%s" % name)
        try:
            with open(path, "r", encoding="utf-8") as handle:
                tpl[name] = handle.read()
        except OSError as exc:
            raise ValueError("Template nicht lesbar: content/templates/%s (%s)" % (name, exc))
    return tpl


def fill(template, mapping):
    out = template
    for key, value in mapping.items():
        out = out.replace("{{" + key + "}}", value)
    return out


# --- Markdown ---------------------------------------------------------------

def _render_inline_text(text):
    text = esc(text)
    text = IMG_RE.sub(
        lambda m: '<img src="%s" alt="%s">' % (m.group(2), m.group(1)), text)
    text = INLINE_LINK_RE.sub(
        lambda m: '<a href="%s">%s</a>' % (m.group(2), m.group(1)), text)
    text = BOLD_RE.sub(r"<strong>\1</strong>", text)
    text = ITALIC_RE.sub(r"<em>\1</em>", text)
    return text


def render_inline(text):
    text = str(text)
    parts = []
    pos = 0
    for match in CODE_SPAN_RE.finditer(text):
        if match.start() > pos:
            parts.append(("text", text[pos:match.start()]))
        parts.append(("code", match.group(1)))
        pos = match.end()
    if pos < len(text):
        parts.append(("text", text[pos:]))
    out = []
    for kind, value in parts:
        if kind == "code":
            out.append("<code>%s</code>" % esc(value))
        else:
            out.append(_render_inline_text(value))
    return "".join(out)


def _is_hr(line):
    return bool(re.match(r"^(-{3,}|\*{3,}|_{3,})$", line.strip()))


def _list_kind(line):
    stripped = line.strip()
    if re.match(r"^[-*+]\s+", stripped):
        return "ul"
    if re.match(r"^\d+[.)]\s+", stripped):
        return "ol"
    return None


def _is_block_start(line):
    stripped = line.strip()
    if stripped == "":
        return True
    if stripped.startswith("```"):
        return True
    if re.match(r"^#{1,6}\s+", stripped):
        return True
    if _is_hr(stripped):
        return True
    if stripped.startswith(">"):
        return True
    if _list_kind(stripped):
        return True
    return False


def render_markdown(text):
    if text is None:
        return ""
    text = str(text).replace("\r\n", "\n").replace("\r", "\n")
    lines = text.split("\n")
    out = []
    i = 0
    n = len(lines)
    while i < n:
        stripped = lines[i].strip()
        if stripped == "":
            i += 1
            continue
        if stripped.startswith("```"):
            lang = stripped[3:].strip()
            i += 1
            buf = []
            while i < n and not lines[i].strip().startswith("```"):
                buf.append(lines[i])
                i += 1
            if i < n:
                i += 1
            cls = ' class="language-%s"' % esc(slugify(lang)) if lang else ""
            out.append("<pre><code%s>%s</code></pre>" % (
                cls, esc("\n".join(buf))))
            continue
        heading = re.match(r"^(#{1,6})\s+(.*?)\s*#*\s*$", stripped)
        if heading:
            level = min(len(heading.group(1)), 6)
            out.append("<h%d>%s</h%d>" % (
                level, render_inline(heading.group(2)), level))
            i += 1
            continue
        if _is_hr(stripped):
            out.append("<hr>")
            i += 1
            continue
        if stripped.startswith(">"):
            buf = []
            while i < n and lines[i].strip().startswith(">"):
                buf.append(lines[i].strip()[1:].strip())
                i += 1
            out.append("<blockquote>%s</blockquote>" % render_inline(" ".join(buf)))
            continue
        kind = _list_kind(stripped)
        if kind:
            tag = "ul" if kind == "ul" else "ol"
            items = []
            while i < n:
                cur = lines[i].strip()
                if _list_kind(cur) != kind:
                    break
                content = re.sub(r"^([-*+]|\d+[.)])\s+", "", cur)
                items.append("  <li>%s</li>" % render_inline(content))
                i += 1
            out.append("<%s>\n%s\n</%s>" % (tag, "\n".join(items), tag))
            continue
        buf = []
        while i < n and lines[i].strip() != "" and not _is_block_start(lines[i]):
            buf.append(lines[i].strip())
            i += 1
        if buf:
            out.append("<p>%s</p>" % render_inline(" ".join(buf)))
        else:
            i += 1
    if not out:
        return ""
    return "\n".join(out) + "\n"


