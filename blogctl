def format_german_number(val):
    if isinstance(val, (int, float)):
        if isinstance(val, float) and val.is_integer():
            val = int(val)
        if isinstance(val, int):
            return f"{val:,}".replace(",", ".")
        s = f"{val:.6f}".rstrip("0").rstrip(".")
        if "." in s:
            int_part, frac_part = s.split(".", 1)
            int_formatted = f"{int(int_part):,}".replace(",", ".")
            return f"{int_formatted},{frac_part}"
        else:
            return f"{int(s):,}".replace(",", ".")
    return str(val)


def calculate_ticks(max_val, target_ticks=4):
    if max_val <= 0:
        return [0, 1]
    raw_step = max_val / target_ticks
    mag = 10 ** math.floor(math.log10(raw_step)) if raw_step > 0 else 1
    norm = raw_step / mag
    if norm <= 1.2:
        step = 1.0 * mag
    elif norm <= 2.2:
        step = 2.0 * mag
    elif norm <= 3.0:
        step = 2.5 * mag
    elif norm <= 6.0:
        step = 5.0 * mag
    else:
        step = 10.0 * mag

    ticks = [0]
    cur = step
    while cur < max_val - 1e-9:
        ticks.append(round(cur, 8))
        cur += step
    ticks.append(round(cur, 8))
    return ticks


def load_chart(name):
    clean_name = os.path.basename(name).replace(".json", "")
    chart_path = os.path.join(CHARTS, "%s.json" % clean_name)
    rel_path = os.path.relpath(chart_path, ROOT)
    if not os.path.isfile(chart_path):
        return None, "Diagramm '%s' nicht gefunden: %s fehlt" % (clean_name, rel_path)
    try:
        with open(chart_path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except Exception as exc:
        return None, "%s ist kein gueltiges JSON: %s" % (rel_path, exc)

    if not isinstance(data, dict):
        return None, "%s muss ein JSON-Objekt sein" % rel_path

    titel = data.get("titel")
    if not titel or not isinstance(titel, str) or not titel.strip():
        return None, "%s: Pflichtfeld 'titel' fehlt oder ist leer" % rel_path

    typ = data.get("typ")
    if typ not in VALID_CHART_TYPES:
        return None, "%s: ungueltiger Typ '%s' (erlaubt: %s)" % (
            rel_path, typ, ", ".join("'%s'" % t for t in VALID_CHART_TYPES)
        )

    if typ == "balken":
        has_werte = "werte" in data
        has_gruppen = "gruppen" in data and "reihen" in data
        if not (has_werte or has_gruppen):
            return None, "%s: Typ 'balken' erfordert 'werte' oder ('gruppen' und 'reihen')" % rel_path
        if has_werte:
            werte = data["werte"]
            if not isinstance(werte, list) or len(werte) == 0:
                return None, "%s: 'werte' muss eine nicht-leere Liste sein" % rel_path
            for idx, item in enumerate(werte):
                if not isinstance(item, dict) or "label" not in item or "wert" not in item:
                    return None, "%s: ungueltiges Element in 'werte' an Index %d" % (rel_path, idx)
                if not isinstance(item["wert"], (int, float)):
                    return None, "%s: 'wert' an Index %d muss eine Zahl sein" % (rel_path, idx)
        if has_gruppen:
            gruppen = data["gruppen"]
            reihen = data["reihen"]
            if not isinstance(gruppen, list) or len(gruppen) == 0:
                return None, "%s: 'gruppen' muss eine nicht-leere Liste sein" % rel_path
            if not isinstance(reihen, list) or len(reihen) == 0:
                return None, "%s: 'reihen' muss eine nicht-leere Liste sein" % rel_path
            for idx, reihe in enumerate(reihen):
                if not isinstance(reihe, dict) or "name" not in reihe or "werte" not in reihe:
                    return None, "%s: ungueltige Reihe an Index %d" % (rel_path, idx)
                if not isinstance(reihe["werte"], list) or len(reihe["werte"]) != len(gruppen):
                    return None, "%s: Anzahl der Werte in Reihe '%s' (%d) stimmt nicht mit Gruppen (%d) ueberein" % (
                        rel_path, reihe.get("name", idx),
                        len(reihe["werte"]) if isinstance(reihe.get("werte"), list) else 0, len(gruppen)
                    )
                for w_idx, w in enumerate(reihe["werte"]):
                    if not isinstance(w, (int, float)):
                        return None, "%s: Wert an Index %d in Reihe '%s' muss eine Zahl sein" % (
                            rel_path, w_idx, reihe.get("name", idx)
                        )
    elif typ == "balken-horizontal":
        if "werte" not in data:
            return None, "%s: Typ 'balken-horizontal' erfordert 'werte'" % rel_path
        werte = data["werte"]
        if not isinstance(werte, list) or len(werte) == 0:
            return None, "%s: 'werte' muss eine nicht-leere Liste sein" % rel_path
        for idx, item in enumerate(werte):
            if not isinstance(item, dict) or "label" not in item or "wert" not in item:
                return None, "%s: ungueltiges Element in 'werte' an Index %d" % (rel_path, idx)
            if not isinstance(item["wert"], (int, float)):
                return None, "%s: 'wert' an Index %d muss eine Zahl sein" % (rel_path, idx)
    elif typ == "gestapelt":
        if "gruppen" not in data or "reihen" not in data:
            return None, "%s: Typ 'gestapelt' erfordert 'gruppen' und 'reihen'" % rel_path
        gruppen = data["gruppen"]
        reihen = data["reihen"]
        if not isinstance(gruppen, list) or len(gruppen) == 0:
            return None, "%s: 'gruppen' muss eine nicht-leere Liste sein" % rel_path
        if not isinstance(reihen, list) or len(reihen) == 0:
            return None, "%s: 'reihen' muss eine nicht-leere Liste sein" % rel_path
        for idx, reihe in enumerate(reihen):
            if not isinstance(reihe, dict) or "name" not in reihe or "werte" not in reihe:
                return None, "%s: ungueltige Reihe an Index %d" % (rel_path, idx)
            if not isinstance(reihe["werte"], list) or len(reihe["werte"]) != len(gruppen):
                return None, "%s: Anzahl der Werte in Reihe '%s' (%d) stimmt nicht mit Gruppen (%d) ueberein" % (
                    rel_path, reihe.get("name", idx),
                    len(reihe["werte"]) if isinstance(reihe.get("werte"), list) else 0, len(gruppen)
                )
            for w_idx, w in enumerate(reihe["werte"]):
                if not isinstance(w, (int, float)):
                    return None, "%s: Wert an Index %d in Reihe '%s' muss eine Zahl sein" % (
                        rel_path, w_idx, reihe.get("name", idx)
                    )
    elif typ in ("linie", "flaeche", "punkte"):
        if "x" not in data or "reihen" not in data:
            return None, "%s: Typ '%s' erfordert 'x' und 'reihen'" % (rel_path, typ)
        x_vals = data["x"]
        reihen = data["reihen"]
        if not isinstance(x_vals, list) or len(x_vals) == 0:
            return None, "%s: 'x' muss eine nicht-leere Liste sein" % rel_path
        if not isinstance(reihen, list) or len(reihen) == 0:
            return None, "%s: 'reihen' muss eine nicht-leere Liste sein" % rel_path
        for idx, reihe in enumerate(reihen):
            if not isinstance(reihe, dict) or "name" not in reihe or "werte" not in reihe:
                return None, "%s: ungueltige Reihe an Index %d" % (rel_path, idx)
            if not isinstance(reihe["werte"], list) or len(reihe["werte"]) != len(x_vals):
                return None, "%s: Anzahl der Werte in Reihe '%s' (%d) stimmt nicht mit x (%d) ueberein" % (
                    rel_path, reihe.get("name", idx),
                    len(reihe["werte"]) if isinstance(reihe.get("werte"), list) else 0, len(x_vals)
                )
            for w_idx, w in enumerate(reihe["werte"]):
                if not isinstance(w, (int, float)):
                    return None, "%s: Wert an Index %d in Reihe '%s' muss eine Zahl sein" % (
                        rel_path, w_idx, reihe.get("name", idx)
                    )
    elif typ == "anteil":
        has_single = "wert" in data and "von" in data
        has_multi = "anteile" in data
        if not (has_single or has_multi):
            return None, "%s: Typ 'anteil' erfordert ('wert' und 'von') oder 'anteile'" % rel_path
        if has_single:
            if not isinstance(data["wert"], (int, float)) or data["wert"] < 0:
                return None, "%s: 'wert' muss eine nicht-negative Zahl sein" % rel_path
            if not isinstance(data["von"], (int, float)) or data["von"] <= 0:
                return None, "%s: 'von' muss eine Zahl groesser als 0 sein" % rel_path
        if has_multi:
            anteile = data["anteile"]
            if not isinstance(anteile, list) or len(anteile) == 0:
                return None, "%s: 'anteile' muss eine nicht-leere Liste sein" % rel_path
            for idx, item in enumerate(anteile):
                if not isinstance(item, dict) or "label" not in item or "wert" not in item:
                    return None, "%s: ungueltiges Element in 'anteile' an Index %d" % (rel_path, idx)
                if not isinstance(item["wert"], (int, float)) or item["wert"] < 0:
                    return None, "%s: 'wert' an Index %d in 'anteile' muss eine nicht-negative Zahl sein" % (rel_path, idx)
            if sum(it["wert"] for it in anteile) <= 0:
                return None, "%s: Summe der Werte in 'anteile' muss groesser als 0 sein" % rel_path

    return data, None


def list_charts():
