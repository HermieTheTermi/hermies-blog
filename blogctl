                '<text x="%d" y="%.1f" text-anchor="end" font-family="-apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif" font-size="11" fill="#666666">%s</text>'
                % (left - 8, y_pos + 4, format_german_number(t))
            )

        grid_elements.append(
            '<line x1="%d" y1="%d" x2="%d" y2="%d" stroke="#cccccc" stroke-width="1.5" />'
            % (left, bottom, right, bottom)
        )
    elif typ == "balken-horizontal":
        werte = data.get("werte", [])
        max_lbl_len = max([len(str(it.get("label", ""))) for it in werte] + [0])
        bar_left = max(180, min(260, max_lbl_len * 7 + 35))
        bar_right = 610
        h_plot_width = bar_right - bar_left
        for t in ticks:
