    if args.json:
        emit_json({"ok": True, "id": args.id, "path": relpath(path)})
    else:
        sys.stdout.write("Bearbeitet: %s\n" % args.id)
    return 0


def _move(ids, target_dir, status):
    moved = []
    for article_id in ids:
        path = find_article(article_id)
        if not path:
            raise ValueError("Artikel nicht gefunden: %s" % article_id)
        fm, body = read_article(path)
        fm["status"] = status
        dest = os.path.join(target_dir, article_id + ".md")
        write_article(dest, fm, body)
        if os.path.abspath(dest) != os.path.abspath(path):
            os.remove(path)
        moved.append(article_id)
    return moved


def cmd_publish(args):
    published = _move(args.ids, POSTS, "published")
    if args.json:
        emit_json({"ok": True, "published": published})
    else:
        sys.stdout.write("Veroeffentlicht: %s\n" % ", ".join(published))
    return 0


def cmd_unpublish(args):
    drafts = _move(args.ids, DRAFTS, "draft")
    if args.json:
        emit_json({"ok": True, "drafts": drafts})
    else:
        sys.stdout.write("Zurueck als Entwurf: %s\n" % ", ".join(drafts))
    return 0


def cmd_rm(args):
    if not args.yes:
        if args.json:
            emit_json({"ok": False, "removed": []})
        sys.stderr.write("Fehler: Abbruch, --yes fehlt\n")
        return 1
    path = find_article(args.id)
    if not path:
        raise ValueError("Artikel nicht gefunden: %s" % args.id)
    os.remove(path)
    if args.json:
        emit_json({"ok": True, "removed": [args.id]})
    else:
        sys.stdout.write("Geloescht: %s\n" % args.id)
    return 0


def cmd_check(args):
    errors = []
    warnings = []
    seen_ids = {}
    seen_source = {}
    articles = list_articles("all")
    for it in articles:
        article_id = it["id"]
        path = it["path"]
        fm, body = read_article(path)
        expected_status = article_status_from_path(path)
        for field in REQUIRED:
            if field not in fm or fm[field] in ("", None, []):
                errors.append("%s: Pflichtfeld '%s' fehlt" % (article_id, field))
        if fm.get("slug") and fm.get("slug") != article_id:
            errors.append("%s: slug '%s' passt nicht zum Dateinamen" % (article_id, fm.get("slug")))
        if fm.get("status") and fm.get("status") != expected_status:
            errors.append("%s: status '%s' passt nicht zum Ordner (%s)" % (
                article_id, fm.get("status"), expected_status))
        if fm.get("date"):
            try:
                datetime.datetime.strptime(str(fm["date"]), "%Y-%m-%d")
            except Exception:
                errors.append("%s: Datum '%s' ist kein ISO-Datum" % (article_id, fm["date"]))
        if article_id in seen_ids:
            errors.append("%s: doppelte id/slug (auch in %s)" % (article_id, seen_ids[article_id]))
        else:
            seen_ids[article_id] = path
        source = fm.get("source_url")
        if source:
            if source in seen_source:
                warnings.append("%s: doppelte source_url (%s)" % (article_id, source))
            else:
                seen_source[source] = article_id
            if not fm.get("source_name"):
                warnings.append("%s: source_url ohne source_name" % article_id)
        if not fm.get("summary"):
            warnings.append("%s: summary fehlt" % article_id)
        if not fm.get("tags"):
            warnings.append("%s: tags fehlen" % article_id)
        base_dir = os.path.dirname(path)
        for target in LINK_RE.findall(body):
            clean = target.split("#")[0].split("?")[0].strip()
            if clean == "" or clean.startswith(
                    ("http://", "https://", "mailto:", "tel:", "/", "data:")):
                continue
            candidates = [
                os.path.normpath(os.path.join(base_dir, clean)),
                os.path.normpath(os.path.join(ROOT, clean)),
                os.path.normpath(os.path.join(CONTENT, clean)),
            ]
            if any(os.path.exists(c) for c in candidates):
                continue
            stem = os.path.splitext(os.path.basename(clean))[0]
            if find_article(stem):
                continue
            errors.append("%s: interner Link zeigt ins Leere: %s" % (article_id, target))
    seen_pages = {}
    for page in list_pages():
        slug = page["slug"]
        if not page["title"]:
            errors.append("%s: Pflichtfeld 'title' fehlt" % slug)
        if not (page["body"] or "").strip():
            errors.append("%s: leerer Body" % slug)
        if slug in seen_ids:
            errors.append("%s: slug kollidiert mit Artikel" % slug)
        if slug in seen_pages:
            errors.append("%s: doppelte Seiten-slug (auch in %s)" % (slug, seen_pages[slug]))
        else:
            seen_pages[slug] = page["path"]
    ok = not errors
    if args.json:
        emit_json({"ok": ok, "errors": errors, "warnings": warnings})
    else:
        for err in errors:
            sys.stdout.write("FEHLER: %s\n" % err)
        for warn in warnings:
            sys.stdout.write("WARNUNG: %s\n" % warn)
        sys.stdout.write("check: %s (%d Artikel, %d Fehler, %d Warnungen)\n" % (
            "ok" if ok else "fehlgeschlagen", len(articles), len(errors), len(warnings)))
    return 0 if ok else 1


