def extract_representation_markers(markdown_text):
    if not markdown_text:
        return []
    lines = str(markdown_text).split("\n")
    clean_lines = []
    in_code_block = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("```"):
            in_code_block = not in_code_block
            continue
        if not in_code_block:
            clean_lines.append(line)
    text = "\n".join(clean_lines)
    text_without_code = CODE_SPAN_RE.sub("", text)
    markers = []
    for match in LEX_MARKER_RE.finditer(text_without_code):
        raw = match.group(1).strip()
        markers.append(html.unescape(raw))
    return markers


def validate_lexikon():
    errors = []
    if not os.path.isfile(LEXIKON_JSON):
        errors.append("content/lexikon.json fehlt")
        return {}, errors
    try:
        with open(LEXIKON_JSON, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except Exception as exc:
        errors.append("content/lexikon.json ist kein gueltiges JSON: %s" % exc)
        return {}, errors

    if not isinstance(data, dict):
        errors.append("content/lexikon.json muss ein JSON-Objekt sein")
        return {}, errors

    seen_lower = {}
    for key, val in data.items():
        if not isinstance(key, str) or not isinstance(val, str):
            errors.append("content/lexikon.json muss ein flaches Objekt String->String sein")
            continue
        if not val.strip():
            errors.append("content/lexikon.json: leerer Erklaerungstext fuer '%s'" % key)
        k_lower = key.lower()
        if k_lower in seen_lower:
            errors.append("content/lexikon.json: doppelter Begriff '%s' (kollidiert mit '%s')" % (key, seen_lower[k_lower]))
        else:
            seen_lower[k_lower] = key

    return data, errors


