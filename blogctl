def _as_list(value):
    if value is None or value == "":
        return []
    if isinstance(value, list):
        return [str(v) for v in value]
    return [str(value)]


def _tag_slug(tag):
    return slugify(str(tag))


def _tag_links_html(tags, prefix):
    parts = []
    for tag in tags:
        parts.append('<a class="tag" href="%stag/%s.html">#%s</a>' % (
            prefix, _tag_slug(tag), esc(tag)))
    return " ".join(parts)


def _post_list_html(posts, prefix):
    if not posts:
        return '<p class="empty">Noch keine Beiträge.</p>\n'
    out = ['<ul class="post-list">']
    for post in posts:
        tags = _as_list(post.get("tags"))
        meta_extra = ""
        if tags:
            meta_extra = ' · <span class="tags">%s</span>' % _tag_links_html(tags, prefix)
        out.append('  <li class="post-item">')
        out.append('    <h2 class="post-item-title"><a href="%s.html">%s</a></h2>' % (
            prefix + post["id"], esc(post["title"])))
        out.append('    <p class="meta"><time datetime="%s">%s</time>%s</p>' % (
            esc(post["date"]), esc(post["date"]), meta_extra))
        if post.get("summary"):
            out.append('    <p class="summary">%s</p>' % esc(post["summary"]))
        out.append('  </li>')
    out.append('</ul>')
    return "\n".join(out) + "\n"


def render_base(tpl, site, prefix, title, description, content):
    mapping = {
        "LANG": esc(site["lang"]),
        "TITLE": esc(title),
        "DESCRIPTION": esc(description),
        "SITE_TITLE": esc(site["title"]),
        "SITE_DESCRIPTION": esc(site["description"]),
        "CSS_HREF": prefix + "style.css",
        "HOME_HREF": prefix + "index.html",
        "FEED_HREF": prefix + "feed.xml",
        "TAGS_HREF": prefix + "tags.html",
        "IMPRESSUM_HREF": prefix + "impressum.html",
        "DATENSCHUTZ_HREF": prefix + "datenschutz.html",
        "CONTENT": content,
    }
    return fill(tpl["base.html"], mapping)


